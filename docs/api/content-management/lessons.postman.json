        {
          "name": "Update Lesson - Third Update (Version 3→4)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"[Version Tracking] Third UPDATE increments to version 4\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.content.version).to.equal(4);",
                  "    pm.collectionVariables.set('lessonVersion', json.content.version);",
                  "    console.log('✅ Third UPDATE lesson version:', json.content.version);",
                  "});",
                  "",
                  "pm.test(\"[Version Tracking] Property 1: Monotonic Increment (3→4)\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.content.version).to.be.greaterThan(3);",
                  "});",
                  "",
                  "pm.test(\"[Version Tracking] Multiple updates maintain monotonicity\", function () {",
                  "    var json = pm.response.json();",
                  "    // After CREATE (v1) + 3 UPDATEs, should be v4",
                  "    pm.expect(json.content.version).to.equal(4);",
                  "    console.log('✅ Version tracking validated: CREATE(1) → UPDATE(2) → UPDATE(3) → UPDATE(4)');",
