              "mode": "raw",
              "raw": "{\n  \"title\": \"Duplicate Lesson\",\n  \"order\": 1,\n  \"content\": {\n    \"content\": { \"type\": \"doc\", \"content\": [] },\n    \"version\": 1,\n    \"lastEdit\": \"2024-01-15T10:00:00Z\"\n  }\n}"
            },
            "url": {
