  "item": [
    {
      "name": "1. Create Lesson",
      "item": [
        {
          "name": "Create Lesson - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has lesson data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('sectionId');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('order');",
                  "    pm.expect(jsonData).to.have.property('content');",
                  "    pm.expect(jsonData.title).to.eql('Introduction to HTML Tags');",
                  "    pm.expect(jsonData.order).to.eql(1);",
                  "    ",
                  "    // Save lessonId for later tests",
                  "    pm.collectionVariables.set('lessonId', jsonData.id);",
                  "});",
                  "",
                  "pm.test(\"Content has valid Tiptap structure\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.have.property('content');",
                  "    pm.expect(jsonData.content).to.have.property('version');",
                  "    pm.expect(jsonData.content).to.have.property('lastEdit');",
                  "    pm.expect(jsonData.content.content).to.have.property('type', 'doc');",
                  "    pm.expect(jsonData.content.content).to.have.property('content');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction to HTML Tags\",\n  \"order\": 1,\n  \"content\": {\n    \"content\": {\n      \"type\": \"doc\",\n      \"content\": [\n        {\n          \"type\": \"heading\",\n          \"attrs\": { \"level\": 1 },\n          \"content\": [\n            { \"type\": \"text\", \"text\": \"HTML Tags\" }\n          ]\n        },\n        {\n          \"type\": \"paragraph\",\n          \"content\": [\n            { \"type\": \"text\", \"text\": \"HTML tags are the building blocks of web pages.\" }\n          ]\n        }\n      ]\n    },\n    \"version\": 1,\n    \"lastEdit\": \"2024-01-15T10:00:00Z\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseSlug}}/sections/{{sectionId}}/lessons",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "{{courseSlug}}", "sections", "{{sectionId}}", "lessons"]
            },
            "description": "Create a new lesson with valid Tiptap content\n\nRequirements: 2.1, 2.7, 2.8, 9.2, 9.3, 9.6, 9.9"
          },
          "response": []
        },
        {
