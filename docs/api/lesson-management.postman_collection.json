    {
      "name": "2. List Lessons",
      "item": [
        {
          "name": "List Lessons - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has lessons array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('lessons');",
                  "    pm.expect(jsonData.lessons).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Lessons are ordered by order field\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.lessons.length > 1) {",
                  "        for (let i = 0; i < jsonData.lessons.length - 1; i++) {",
                  "            pm.expect(jsonData.lessons[i].order).to.be.at.most(jsonData.lessons[i + 1].order);",
                  "        }",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Each lesson has contentPreview (not full content)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.lessons.length > 0) {",
                  "        pm.expect(jsonData.lessons[0]).to.have.property('contentPreview');",
                  "        pm.expect(jsonData.lessons[0]).to.not.have.property('content');",
                  "        pm.expect(jsonData.lessons[0].contentPreview.length).to.be.at.most(200);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseSlug}}/sections/{{sectionId}}/lessons",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "{{courseSlug}}", "sections", "{{sectionId}}", "lessons"]
            },
            "description": "List all lessons in a section with content preview (first 200 chars)\n\nRequirements: 2.2, 8.3"
