{
  "info": {
    "name": "Section Management API",
    "description": "API testing collection for Course Content Management - Section endpoints\n\nCommit: 409a201606ba5281e3e1007be9138b4c23be1860\nFeature: MGR-27 - Course Content Management V2\nRequirements: 1.1-1.8, 8.1-8.3, 9.1, 9.5, 9.8, 12.6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "courseSlug",
      "value": "web-dev-101",
      "type": "string"
    },
    {
      "key": "sectionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Section",
      "item": [
        {
          "name": "Create Section - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has section data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('courseId');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('order');",
                  "    pm.expect(jsonData.title).to.eql('Introduction to HTML');",
                  "    pm.expect(jsonData.order).to.eql(1);",
                  "    ",
                  "    // Save sectionId for later tests",
                  "    pm.collectionVariables.set('sectionId', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction to HTML\",\n  \"description\": \"Learn the basics of HTML\",\n  \"order\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseSlug}}/sections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "{{courseSlug}}", "sections"]
            },
            "description": "Create a new section with valid data\n\nRequirements: 1.1, 1.6, 9.1, 9.5"
          },
          "response": []
        },
        {
          "name": "Create Section - Duplicate Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 or 409\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "});",
                  "",
                  "pm.test(\"Error message indicates duplicate order\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('error');",
                  "    pm.expect(jsonData.error).to.include('already exists');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Duplicate Section\",\n  \"description\": \"Test\",\n  \"order\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseSlug}}/sections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "{{courseSlug}}", "sections"]
            },
            "description": "Test validation: duplicate order should be rejected\n\nRequirements: 9.8"
          },
          "response": []
        },
        {
          "name": "Create Section - Course Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error message indicates course not found\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('error');",
                  "    pm.expect(jsonData).to.have.property('code', 'NOT_FOUND');",
                  "    pm.expect(jsonData.error).to.include('Course not found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Section\",\n  \"description\": \"Test\",\n  \"order\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses/non-existent-course/sections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "non-existent-course", "sections"]
            },
            "description": "Test error handling: course not found\n\nRequirements: 9.5"
          },
          "response": []
        }
      ],
      "description": "Tests for POST /api/courses/[slug]/sections endpoint"
    },
    {
      "name": "2. List Sections",
      "item": [
        {
          "name": "List Sections - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has sections array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('sections');",
                  "    pm.expect(jsonData.sections).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Sections are ordered by order field\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.sections.length > 1) {",
                  "        for (let i = 0; i < jsonData.sections.length - 1; i++) {",
                  "            pm.expect(jsonData.sections[i].order).to.be.at.most(jsonData.sections[i + 1].order);",
                  "        }",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Each section has lessonCount\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.sections.length > 0) {",
                  "        pm.expect(jsonData.sections[0]).to.have.property('lessonCount');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseSlug}}/sections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses", "{{courseSlug}}", "sections"]
            },
            "description": "List all sections in a course, ordered by order field\n\nRequirements: 1.2, 8.3"
          },
          "response": []
        },
        {
