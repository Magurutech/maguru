{
  "name": "maguru",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "app": "cross-env APP_ENV=dev npx next dev --turbopack",
    "app:prod": "cross-env APP_ENV=prod npx next dev --turbopack",
    "build": "next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit --skipLibCheck",
    "test": "jest app/creator/dashboard/page.test.tsx  --verbose",
    "test:watch": "jest --watch",
    "test:unit": "jest features/cms  --verbose --passWithNoTests",
    "test:unit:all": "jest features/ --verbose --passWithNoTests",
    "test:integration": "jest __tests__/integration/course/frontend --verbose --passWithNoTests",
    "test:integration:all": "jest __tests__/integration --verbose --passWithNoTests",
    "test:e2e": "cross-env NODE_ENV=test  playwright test __tests__/playwright/course/creator",
    "test:e2e:all": "cross-env NODE_ENV=test playwright test __tests__/playwright/",
    "test:e2e:report": "playwright show-report services/playwright-report",
    "test:api:student": "newman run docs/api/student-course/student-course.postman_collection.json --environment docs/api/newman-env.json --reporters cli",
    "test:api:creator": "newman run docs/api/creator-course/creator-course.postman_collection.json --environment docs/api/newman-env.json --reporters cli",
    "test:api": "npm run test:api:student && npm run test:api:creator"
  },
